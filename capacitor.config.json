{
  "appId": "app.modernvillage.ios",
  "appName": "Modern Village",
  "webDir": "www",
  "server": {
    "url": "https://modernvillage.app/app.html",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "modernvillage.app",
      "*.modernvillage.app",
      "*.supabase.co",
      "*.supabase.in",
      "accounts.google.com",
      "*.google.com",
      "*.googleapis.com",
      "apis.google.com",
      "appleid.apple.com",
      "*.stripe.com",
      "js.stripe.com",
      "*.anthropic.com",
      "*.cloudflare.com",
      "*.workers.dev",
      "*.vercel.app"
    ]
  },
  "ios": {
    "contentInset": "automatic",
    "limitsNavigationsToAppBoundDomains": false,
    "scrollEnabled": true
  }
}
